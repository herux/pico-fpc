# Makefile for Pico-FPC
#
# Free Pascal build system for Raspberry Pi Pico
#

# Toolchain - detect cross compiler
FPC_NATIVE := $(shell which fpc 2>/dev/null)
FPC_CROSS := $(shell which ppcrossarm 2>/dev/null)

ifeq ($(FPC_CROSS),)
  # Try common locations
  FPC_CROSS := $(shell ls /usr/local/lib/fpc/*/ppcrossarm 2>/dev/null | tail -1)
endif

ifeq ($(FPC_CROSS),)
  FPC = ppcrossarm
  $(warning ppcrossarm not found! See BUILDING.md for installation instructions)
else
  FPC = $(FPC_CROSS)
endif

OBJCOPY = arm-none-eabi-objcopy
ELF2UF2 = elf2uf2

# Target
TARGET_CPU = cortex-m0plus
TARGET_ARCH = armv6m

# Directories
SRC_DIR = src
RTL_DIR = $(SRC_DIR)/rtl
HARDWARE_DIR = $(SRC_DIR)/hardware
PICO_DIR = $(SRC_DIR)/pico
STARTUP_DIR = $(SRC_DIR)/startup
EXAMPLES_DIR = examples
LINKER_DIR = linker
BUILD_DIR = build

# Unit search path (RTL first!)
UNIT_PATH = -Fu$(RTL_DIR) -Fu$(HARDWARE_DIR) -Fu$(PICO_DIR) -Fu$(STARTUP_DIR)

# Compiler flags for ARM embedded
FPC_FLAGS = -Tembedded \
            -Cparmv6m \
            -O2 \
            -XX \
            -CX \
            -Xt \
            -a \
            $(UNIT_PATH) \
            -FE$(BUILD_DIR) \
            -FU$(BUILD_DIR)

# Linker flags
LD_FLAGS = -k-Tlinker/rp2040.ld \
           -k-nostdlib \
           -k-nostartfiles

# Examples
EXAMPLES = blink

.PHONY: all clean blink uf2 check-tools help

all: check-tools $(BUILD_DIR) $(EXAMPLES)

$(BUILD_DIR):
	@mkdir -p $(BUILD_DIR)

check-tools:
	@echo "Checking tools..."
	@echo "  FPC: $(FPC)"
	@if [ ! -x "$(FPC)" ] && ! command -v $(FPC) >/dev/null 2>&1; then \
		echo "ERROR: ppcrossarm not found!"; \
		echo "See BUILDING.md for installation instructions"; \
		exit 1; \
	fi
	@echo "  Tools OK"

# Build RTL first
$(BUILD_DIR)/system.ppu: $(RTL_DIR)/system.pas | $(BUILD_DIR)
	@echo "Compiling RTL..."
	$(FPC) -Tembedded -Cparmv6m -Us -Sg -O2 -FU$(BUILD_DIR) $(RTL_DIR)/system.pas

# Build blink example
blink: $(BUILD_DIR)/system.ppu
	@echo "Compiling blink..."
	$(FPC) $(FPC_FLAGS) $(LD_FLAGS) -o$(BUILD_DIR)/$@ $(EXAMPLES_DIR)/blink/blink.pas
	@if [ -f "$(BUILD_DIR)/blink" ]; then \
		echo "Built: $(BUILD_DIR)/blink"; \
		ls -la $(BUILD_DIR)/blink; \
	else \
		echo "Compiled units in $(BUILD_DIR)/"; \
	fi

# Convert to UF2 for Pico upload
uf2: blink
	@if command -v $(ELF2UF2) >/dev/null 2>&1; then \
		$(ELF2UF2) $(BUILD_DIR)/blink $(BUILD_DIR)/blink.uf2; \
		echo "Created: $(BUILD_DIR)/blink.uf2"; \
	elif command -v uf2conv >/dev/null 2>&1; then \
		uf2conv $(BUILD_DIR)/blink -o $(BUILD_DIR)/blink.uf2 -f 0xe48bff56; \
		echo "Created: $(BUILD_DIR)/blink.uf2"; \
	else \
		echo "No UF2 converter found. Install elf2uf2 or uf2conv."; \
	fi

clean:
	rm -rf $(BUILD_DIR)

# Help target
help:
	@echo "============================================"
	@echo "  Pico-FPC Build System"
	@echo "============================================"
	@echo ""
	@echo "Targets:"
	@echo "  all        - Build all examples"
	@echo "  blink      - Build blink example"
	@echo "  uf2        - Convert to UF2 for Pico upload"
	@echo "  clean      - Remove build directory"
	@echo "  check-tools- Check if required tools exist"
	@echo "  help       - Show this help"
	@echo ""
	@echo "Requirements:"
	@echo "  - Free Pascal ARM cross-compiler (ppcrossarm)"
	@echo "  - ARM embedded toolchain (arm-none-eabi-*)"
	@echo ""
	@echo "See BUILDING.md for detailed setup instructions."
